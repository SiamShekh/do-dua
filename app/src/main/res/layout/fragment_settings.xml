<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="18dp"
            android:text="@string/nav_settings"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_hero"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/preview_arabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="8dp"
                android:text="@string/preview_arabic"
                android:textColor="@color/teal_deep"
                android:textDirection="rtl"
                android:textSize="26sp"
                tools:text="بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيمِ" />

            <TextView
                android:id="@+id/preview_bangla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/preview_bangla"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/preview_hint"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_appearance"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:elevation="1dp"
            android:orientation="vertical">

            <include
                android:id="@+id/row_theme"
                layout="@layout/item_settings_row" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_typography"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:elevation="1dp"
            android:orientation="vertical">

            <include
                android:id="@+id/row_arabic_font"
                layout="@layout/item_settings_row" />

            <include layout="@layout/item_settings_divider" />

            <include
                android:id="@+id/row_bangla_font"
                layout="@layout/item_settings_row" />

            <include layout="@layout/item_settings_divider" />

            <include
                android:id="@+id/row_arabic_size"
                layout="@layout/item_settings_row" />

            <include layout="@layout/item_settings_divider" />

            <include
                android:id="@+id/row_translation_size"
                layout="@layout/item_settings_row" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
